{"0004e21521":"ஸ கோஹத்யாக்ரு'தம் பாபம் ப்ராப்நோத்யேவ ந ஸம்ஶயஃ॥","02b1c163cd":"வ்யதீபாதே ச ஸங்க்ராந்த்யாம் நந்தாபூதாஷ்டபர்வஸு॥","02bcfabfd8":"[ப்ரு'ஹத்தைவஜ்ஞரஞ்ஜநே/நாரதபுராணே] நாரதஃ—","072f95b802":"ஸ்ம்ரு'திகௌஸ்துபே—","080fbdf4a0":"*நாரிகேலம்* *அலாபும்* ச படோலம் ப்ரு'ஹதீபலம்।","0926c28f68":"க்ஷௌரே ஶநைஶ்சராதித்யபௌமாஹோராத்ரமேவ ச।","09ad3c97cb":"ஸங்க்ராந்த்யாம் பாநுவாரே ச ஸப்தம்யாம் ராஹுதர்ஶநே।","0a337aec1a":"வ்ரு'த்தமநுநோக்தம்---","0be43c014e":"ஹவிஷ்யாந்நம் ச புஞ்ஜீத அக்ஷாரலவணம் ததா।","0c457174c7":"பூமிஶாயீ ப்ரஹ்மசாரீ பவேச்ச தஶமீதிநே॥","0ce9d1b52c":"[ப்ரு'ஹத்தைவஜ்ஞரஞ்ஜநே] வஸிஷ்டஃ—","0fd7f5f285":"நிர்ணயஸிந்தௌ ஸ்ம்ரு'திஸாரே---","10d1abb59b":"திவாநித்ராம் பராந்நம் ச புநர்போஜநமைதுநே।","1484a7e11c":"க்ரமாத்கூஷ்மாண்டப்ரு'ஹதீதருணீ*மூலகம்* ததா।","15f88fb00f":"அபக்ஷ்யம் ச படோலம் ச ஶத்ருவ்ரு'த்திகரம் பரம் [த்ரு'தீயாயாம்]","194bfc75d7":"ததா ப்ரதிபதம் ரிக்தாம் திதிம் ச பரிவர்ஜயேத்॥","1fd00bcbd9":"[ப்ரு'ஹத்தைவஜ்ஞரஞ்ஜநே] சந்த்ரோதயே விஷ்ணுஃ—","201d80810a":"ஶ்ரீபலம் ச கலிங்கம் ச *பலம் தாத்ரீபவம்* ததா॥53॥","216ff1a040":"தைலம் க்ஷௌரம் ரதிம் மாம்ஸம் தந்தகாஷ்டம் விவர்ஜயேத்॥","2176ba9acf":"ஸப்தம்யாம் ச ததா தாலம் ஶரீரஸ்ய ச நாஶகம்॥32॥","228d2907e2":"சர்மவ்ரு'ந்தாகசவலீஶாகம் துலஸிஜம் ததா॥54॥","2337fc9e7f":"பர்வத்வயே ச ஸங்க்ராந்தௌ த்வாதஶ்யாம் ஸூதகத்வயே।","23c9ab3e5b":"அமாரிக்தாஸு ஸங்க்ராந்த்யாம் அஷ்டம்யாமிந்துவாஸரே।","2465b52752":"ப்ரதிபத்தர்ஶஷஷ்டீஷு சதுர்தஶ்யஷ்டமீஷு ச।","2b8efbdaef":"(ரிக்தா = 4, 9, 14)","2ba2bf06c0":"நாரிகேலம் அலாபும் ச படோலம் ப்ரு'ஹதீபலம்।","32676ecb84":"மாகே ச மூலகம் சைவ ... கோமாம்ஸதுல்யகம்।","3694dc0db6":"க்ரமாத்கூஷ்மாண்ட*ப்ரு'ஹதீ**தருணீ*மூலகம் ததா।","3e81f48abc":"ஆமலக-பக்ஷணம்।","3e91f6182e":"பஞ்சபர்வஸு நந்தாஸு ந குர்யாத்தந்ததாவநம்।","3eb0c618c8":"பில்வபத்ரம் ந ச சிந்த்யாச்சிந்த்யாச்சேந்நரகம் வ்ரஜேத்॥","3fdcf4ad1e":"த்விதீயாயாம் ச ப்ரு'ஹதீ","41f311f2f6":"[ப்ரு'ஹத்தைவஜ்ஞரஞ்ஜநே] ஹேமாத்ரௌ ஸ்காந்தே—","44a06b83d5":"க்ரு'ஹிபிர்ப்ராஹ்மணைரந்நம் ஸம்ப்ராப்தே ஹரிவாஸரே॥8॥","46c00f7c95":"ஶாகாந்யேதாநி வர்ஜ்யாநி க்ரமாத்ப்ரதிபதாதிஷு।","4f47ff5a79":"கரோதி மைதுநம் யோ ஹி கும்பீபாகம் ஸ ச வ்ரஜேத்॥","4ff353e021":"ரோகவ்ரு'த்திகரம் சைவ நராணாம் தாலபக்ஷணம்।","518355407b":"ஶாகம் மது பராந்நம் ச தஶம்யாமஷ்ட வர்ஜயேத்॥","53631bd092":"அஸ்ப்ரு'ஶ்யஸ்பர்ஶநே சைவ ந ஸ்நாயாதுஷ்ணவாரிணா॥","5364601d32":"தத்ர குர்யாதநாத்ரு'த்ய ஸ நரோ விதிஹந்தகஃ॥","55946182f5":"*தும்பீ நவம்யாம்* *கோமாம்ஸம் தஶம்யாம் ச கலம்பிகா*॥","563ea05f51":"ப்ராஹ்மணஃ காமதோऽந்நம் ச யோ புங்க்தே ஹரிவாஸரே।","56440d11b8":"சர்ம*வ்ரு'ந்தாக**சவலீ*ஶாகம் துலஸிஜம் ததா॥54॥","5686709460":"புண்யாநி பஞ்ச பர்வாணி ரவிஸங்க்ராதிரேவ ச॥","5b374ab209":"க்ரமாத்கூஷ்மாண்ட*ப்ரு'ஹதீ*தருணீமூலகம் ததா।","6041980018":"*தும்பீ நவம்யாம்* கோமாம்ஸம் தஶம்யாம் ச கலம்பிகா॥","61a3223ede":"நாரிகேலம் அலாபும் ச *படோலம்* *ப்ரு'ஹதீபலம்*।","63dcf6f05a":"க்ரமாத்*கூஷ்மாண்ட**ப்ரு'ஹதீ*தருணீமூலகம் ததா।","67233374eb":"அலாபே தந்தகாஷ்டாநாம் நிஷித்தாயாம் ததா திதௌ।","6aeb5ec672":"நாரிகேலம் அலாபும் ச *படோலம்* ப்ரு'ஹதீபலம்।","6dc808d213":"அப்யங்கே ஜலதிஸ்நாநே தந்ததாவநமைதுநே।","6eb7a75497":"ஶ்ரீஸ்காந்தே மஹாபுராண ஏகாஶீதிஸாஹஸ்ர்யாம் ஸம்ஹிதாயாம் த்விதீயே வைஷ்ணவகண்டே கார்திகமாஸமாஹாத்ம்யே கார்திகவ்ரதநிரூபணம் நாம ஷஷ்டோऽத்யாயஃ---","6ff5349cc4":"நவம்யாம் பாநுவாரே ச தந்தகாஷ்டம் விவர்ஜயேத்॥","7000e1ce7f":"சதுர்தஶ்யஷ்டமீ பௌர்ணமாஸீ ஸங்க்ரமணேஷு ச।","718a4ab4d1":"ஸ்த்ரியம் தைலம் ச மாம்ஸம் ச தந்தகாஷ்டம் ச வர்ஜயேத்॥","7906669dd9":"அப்யங்கஸ்நபநம் தீமாந் ஸுகார்தீ வர்ஜயேத்ததா॥","79af976b99":"காம்ஸ்யம் மாம்ஸம் மஸூராம்ஶ்ச சணகாந் கோத்ரவாம்ஸ்ததா।","79f8b70975":"ஏகாதஶ்யாம் ததா ஶிம்பீ ... ந பக்ஷ்யா புத்ரநாஶநம்॥34॥","7b9567b0ee":"ரோஹிண்யாம் ச விஶாகாயாம் மைத்ரே சைவோத்தராஸு ச।","7bb9df6853":"ரவௌ ஶ்ராத்தே வ்ரதாஹே ச துஷ்டம் ஸ்த்ரீதிலதைலகம்।","7cdd9fc739":"க்ரமாத்கூஷ்மாண்டப்ரு'ஹதீ*தருணீ*மூலகம் ததா।","7e0fdc04bb":"*நாரிகேலம்* அலாபும் ச படோலம் ப்ரு'ஹதீபலம்।","8098dbacaa":"க்ரமாத்கூஷ்மாண்டப்ரு'ஹதீ*தருணீ**மூலகம்* ததா।","821cb090ce":"க்ஷுரகர்மணி வர்ஜ்யாநி பர்வஸந்திஸ்ததைவ ச॥","84640eaa5c":"வாநிங்கணபலம் சைவ கோமாம்ஸம் கார்த்திகே ஸ்ம்ரு'தம்।","84b2598e5a":"உத்தராபால்குநீ ஜ்யேஷ்டா ஶ்ரவணார்த்ராஸு ராத்ரிஷு।","860f9e61cf":"*ஶ்ரீபலம்* ச கலிங்கம் ச பலம் தாத்ரீபவம் ததா॥53॥","86ea404b6a":"த்ரைலோக்யஜநிதம் பாபம் ஸோऽபி புங்க்தே ந ஸம்ஶயஃ॥7॥","8a28cd5cdc":"நவம்யாம் ச ந குர்வீத கதாசித்தந்ததாவநம்॥","8bf9661acf":"துலஸீம் யே விசிந்வந்தி தே  சிந்தந்தி ஹரேஃ ஶிரஃ॥","8dbb760544":"பாநு-பௌமாமராசார்ய-ஶுக்ரவாரேஷு ஸங்க்ரமே।","8e4d7eb1ac":"வ்யதீபாதே ச ஜந்மர்க்ஷே நாப்யங்கஸ்நாநமாசரேத்॥","8f222dfdf3":"ஏகாதஶ்யாம் சதுர்தஶ்யாம் அஷ்டம்யாம் ப்ரதிபத்யபி।","98e95466e1":"*சர்ம*வ்ரு'ந்தாகசவலீஶாகம் துலஸிஜம் ததா॥54॥","a1a6ab13bd":"சதுர்த்யாம் ச மூலகம் தநநாஶநம்॥30॥","a1cedc551c":"ம்ரு'தே ஜந்மநி ஸங்க்ராந்தௌ ஶ்ராத்தே ஜந்மதிநே ததா।","a402e588fb":"பஞ்சபர்வஸு நந்தாஸு வ்யதீபாதே ச ஸங்க்ரமே।","a624a31f90":"[ஸ்ம்ரு'திகௌஸ்துபே] மார்கண்டேயஃ---","a7044880fc":"அபாம் த்வாதஶகண்டூஷைஃ பத்ரைர்வா ஶோதயேந்முகம்॥","a7604fcda1":"வைத்ரு'தௌ ச வ்யதீபாதே பௌம-பார்கவ-பாநுஷு।","ad90df6822":"சர்ம*வ்ரு'ந்தாக*சவலீ*ஶாகம் துலஸிஜம்* ததா॥54॥","b0af303db2":"நந்தாஸு ச நவம்யாம் ச தந்தகாஷ்டம் விவர்ஜயேத்॥","b46167cdb1":"ஶ்ராத்தே யஜ்ஞே ச நியமே ததா ப்ரோஷிதபர்த்ரு'கா।","b72efe1621":"நாரிகேலம் அலாபும் ச படோலம் *ப்ரு'ஹதீபலம்*।","b8000f734b":"ஶ்ரீபலம் ச *கலிங்கம்* ச பலம் தாத்ரீபவம் ததா॥53॥","bbd24ba917":"சதுர்தஶ்யாம் மாஷபக்ஷ்யம் மஹாபாபகரம் பரம்।","bd92dbce20":"ஆரோக்யபுத்ரவித்தார்தீ ந ஸ்நாயாதுஷ்ணவாரிணா॥","be2993fd46":"குஹூபூர்ணேந்துஸங்க்ராந்திசதுர்தஶ்யஷ்டமீஷு ச॥","bf695091fb":"[ஸ்ம்ரு'திகௌஸ்துபே] வ்யாஸஃ---","c1bec4cc55":"ந போக்தவ்யம் ந போக்தவ்யம் ந போக்தவ்யம் ச நாரத।","c63395ae72":"[புருஷார்தசிந்தாமணௌ] மரீசிஃ—","c74bdc7cd9":"ஶ்ரீபலம் ச *கலிங்கம்* ச *பலம் தாத்ரீபவம்* ததா॥53॥","c9e362a866":"ப்ரதிபத்ஸு ச கூஷ்மாண்டமபக்ஷ்யம் ஹ்யர்தநாஶநம்।","ca0d720fd1":"*சர்ம**வ்ரு'ந்தாக*சவலீஶாகம் துலஸிஜம் ததா॥54॥","cdd62747b3":"தர்ஶே ஷஷ்ட்யாம் ப்ரதிபதி த்வாதஶ்யாம் ப்ரதிபர்வஸு।","cf95531148":"மகாயாம் க்ரு'த்திகாயாம் வை சோத்தராஸு ச நாரத।","d2b8ce1fd1":"நாரிகேலம் *அலாபும்* ச படோலம் ப்ரு'ஹதீபலம்।","d429ee3d01":"நாரிகேலபலம் பக்ஷ்யமஷ்டம்யாம் புத்திநாஶநம்।","d483b6e46f":"லிங்கபுராணே---","d63e6e8de0":"சதுர்தஶ்யஷ்டமீ க்ரு'ஷ்ணா த்வமாவஸ்யா ச பூர்ணிமா।","d7210c382f":"[ப்ரு'ஹத்தைவஜ்ஞரஞ்ஜநே] நாரதஃ—","d9ee8282bb":"நாரிகேலம் *அலாபும்* ச *படோலம்* ப்ரு'ஹதீபலம்।","e0733058b4":"க்ரமாத்கூஷ்மாண்டப்ரு'ஹதீதருணீமூலகம் ததா।","e2550dee80":"ஶ்ரீப்ரஹ்மவைவர்தே மஹாபுராணே ப்ரஹ்மகண்டே ஸௌதிஶௌநகஸம்வாதே நாரதம் ப்ரதி ஶிவோபதேஶே பக்ஷ்யாபக்ஷ்யாதிவிவரணம் நாம ஸப்தவிம்ஶதிதமோऽத்யாயஃ---","e2b494c6c5":"ஜந்மாஹே ஶ்ராத்ததிவஸே தந்தகாஷ்டம் விவர்ஜயேத்॥","e32720a22b":"சர்மவ்ரு'ந்தாக*சவலீ*ஶாகம் துலஸிஜம் ததா॥54॥","e6e259997c":"சர்ம*வ்ரு'ந்தாக*சவலீஶாகம் துலஸிஜம் ததா॥54॥","e7e80a441b":"பௌர்ணமாஸ்யாம் ததா தர்ஶே யஃ ஸ்நாயாதுஷ்ணவாரிணா।","ecd34f2b44":"ஶந்யர்கஶுக்ரவாரேஷு குஜாஹே வ்ரதவாஸரே।","f01a5d4d3b":"திர்யக்யோநிம் ப்ராபயேத்து ஷஷ்ட்யாம் வை நிம்பபக்ஷணம்॥31॥","f2dd8db144":"க்ஷௌத்ரம் காம்ஸ்யம் மாஷதைலம் த்வாதஶ்யாமஷ்ட வர்ஜயேத்॥","f31af05d63":"க்ரமாத்*கூஷ்மாண்ட*ப்ரு'ஹதீதருணீமூலகம் ததா।","f42f5f29f2":"சர்மவ்ரு'ந்தாகசவலீ*ஶாகம் துலஸிஜம்* ததா॥54॥","f4b6c14e87":"ஜாதே ச நிதநே சைவ தத்காலவ்யாபிநீ திதிஃ॥","f594214fbd":"அமாயாம் க்ரு'த்திகாயாம் ச த்விஜைஃ க்ஷௌரம் விவர்ஜிதம்॥46॥","f66ae83e62":"அஷ்டமீ ச ததா ஷஷ்டீ நவமீ ச சதுர்தஶீ।","f6f43b4ca9":"*ஶ்ரீபலம்* ச *கலிங்கம்* ச பலம் தாத்ரீபவம் ததா॥53॥","f6f8c5d7c7":"ஷஷ்ட்யாம் பர்வணி சாப்யங்கஸ்நாநம் நைவ ஸமாசரேத்॥","f845ecb9f7":"ஶ்ரீபலம் ச கலிங்கம் ச பலம் தாத்ரீபவம் ததா॥53॥","f8d83a9d01":"த்ரயோதஶ்யாம் ச வார்த்தாகீ ந பக்ஷ்யா புத்ரநாஶநம்॥34॥","f8e32e27b6":"தும்பீ நவம்யாம் *கோமாம்ஸம் தஶம்யாம் ச கலம்பிகா*॥","f983439497":"கலங்ககாரணம் சைவ பஞ்சம்யாம் பில்வபக்ஷணம்।","fce1891637":"த்வாதஶ்யாம் பூதிகா ததா। ... ந பக்ஷ்யா புத்ரநாஶநம்॥34॥"}